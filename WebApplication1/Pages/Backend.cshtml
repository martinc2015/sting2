<h2>Endpoints</h2>
<table>
  <thead><tr><th>Controller</th><th>Método</th><th>URL completa</th><th>Auth</th></tr></thead>
  <tbody>
    <tr><td>QueryController</td><td>GET</td><td><code>api/query</code></td><td>API Key</td></tr>
