    <tr><td>Microsoft.EntityFrameworkCore.Tools</td><td>8.0.12</td><td>herramientas de Entity Framework</td></tr>
    <tr><td>Microsoft.Extensions.Options.ConfigurationExtensions</td><td>8.0.0</td><td>Options pattern / IConfiguration</td></tr>
  </tbody>
</table>

