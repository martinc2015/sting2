    <tr><td>Mapster.DependencyInjection</td><td>1.0.1</td><td>Registro de Mapster en DI</td></tr>
    <tr><td>Microsoft.AspNetCore.Http.Abstractions</td><td>2.3.0</td><td>HttpContext para extensiones de paginación</td></tr>
