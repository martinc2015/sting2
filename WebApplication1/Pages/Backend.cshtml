</table>

<h2>Repositorios</h2>
<table>
  <thead><tr><th>Clase</th><th>Interfaz</th><th>Métodos</th></tr></thead>
  <tbody>
    <tr><td>ReadRepository&lt;T&gt;</td><td>IReadRepository&lt;T&gt;</td><td>GetAllAsync(predicate), GetAllAsync(paginacion, predicate, orderBy, includes, tracking), GetByAsync(predicate)</td></tr>
